# ==========================================
# .gitignore Maestro - SandiStay (Monorepo)
# ==========================================

# --- 1. Sistema Operativo y Editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws

# --- 2. Archivos Comunes y Logs ---
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 3. Backend (Spring Boot / Java / Gradle / Maven) ---
**/target/
**/bin/
**/out/
**/.gradle/
**/build/
**/.settings/
.classpath
.project
*.class
*.jar
*.war
.idea

# --- 4. Frontend (SvelteKit / Node.js) ---
**/node_modules/
**/.svelte-kit/
**/dist/
# (El build de Svelte suele ir a /build o /dist, ya cubiertos arriba)

# --- 5. Docker e Infraestructura ---
.env
.env.*
!.env.example
docker-compose.override.yml
docker-compose.dev.yml
volumes/
pg_data/
uploads/

# --- 6. Reglas Específicas por Carpeta (Monorepo) ---
# Backend específico
backend/.gradle/
backend/build/
backend/out/
backend/bin/

# Frontend específico
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- 7. Directorio SQL_Files ---
# Mantenemos los scripts de estructura y seed base en el repositorio.
# Solo ignoramos el script temporal de pruebas de rendimiento (por si lo vuelves a crear).
SQL_Files/07_seed_test_performance.sql

# Archivos SQL generados dinámicamente para Testcontainers
src/test/resources/init.sql
backend/src/test/resources/init.sql

.kilo

# Certificados SSL locales
nginx/ssl/
*.key
*.crt
